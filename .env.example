# Backend
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
MAX_REQUEST_BYTES=64000
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql+psycopg://bis_sahayak:bis_sahayak@localhost:5432/bis_sahayak
POSTGRES_DB=bis_sahayak
POSTGRES_USER=bis_sahayak
POSTGRES_PASSWORD=change-me-for-local-use

# Provider adapters are intentionally disabled by default.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
GENERATION_PROVIDER=disabled
RERANKER_PROVIDER=disabled

# Ingestion configuration for a later phase
INGESTION_USER_AGENT=BIS-Sahayak/0.1 (contact: maintainers@example.invalid)
APPROVED_SOURCE_REGISTRY=data_sources/sources.yaml

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
